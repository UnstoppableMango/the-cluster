{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"github>UnstoppableMango/renovate-config",
		"schedule:weekly"
	],
	"ignorePaths": [
		"**/vendor/**",
		"**/testdata/**",
		"charts/**",
		"**/crds/**"
	],
	"major": {
		"dependencyDashboardApproval": true
	},
	"kubernetes": {
		"managerFilePatterns": [
			"/^(apps|clusters|infrastructure)/.+\\.ya?ml$/"
		]
	},
	"flux": {
		"managerFilePatterns": [
			"/^(apps|clusters|infrastructure)/.+\\.ya?ml$/"
		]
	},
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": [
				"/nix/.+\\.nix$/"
			],
			"matchStrings": [
				"github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>v[\\d.]+)/"
			],
			"datasourceTemplate": "github-releases"
		},
		{
			"customType": "regex",
			"description": "dockerTools.pullImage base images, tracked by the tag in `finalImageTag`. `imageDigest` holds a per-architecture manifest digest and the docker datasource resolves a tag to the multi-arch index digest, so `currentDigest` is deliberately not captured; digests and nix hashes are refreshed by hand on the PR.",
			"managerFilePatterns": [
				"/^containers/.+\\.nix$/"
			],
			"matchStrings": [
				"imageName = \"(?<depName>[^\"]+)\";[\\s\\S]*?finalImageTag = \"(?<currentValue>[^\"]+)\";"
			],
			"datasourceTemplate": "docker",
			"versioningTemplate": "docker"
		}
	],
	"packageRules": [
		{
			"matchPackageNames": [
				"cert-manager",
				"cert-manager/cert-manager"
			],
			"groupName": "cert-manager"
		},
		{
			"matchPackageNames": [
				"ghcr.io/nginx/charts/nginx-gateway-fabric",
				"ghcr.io/nginx/nginx-gateway-fabric",
				"ghcr.io/nginx/nginx-gateway-fabric/nginx"
			],
			"groupName": "nginx-gateway-fabric"
		},
		{
			"matchPackageNames": [
				"harbor",
				"/^goharbor\\/.*/"
			],
			"groupName": "harbor"
		},
		{
			"matchPackageNames": [
				"/bitnami\\/sealed-secrets-controller/",
				"/bitnami-labs\\/sealed-secrets/"
			],
			"groupName": "sealed-secrets"
		},
		{
			"matchPackageNames": [
				"external-dns",
				"kubernetes-sigs/external-dns",
				"registry.k8s.io/external-dns/external-dns"
			],
			"groupName": "external-dns"
		},
		{
			"matchPackageNames": [
				"cloudflare/origin-ca-issuer"
			],
			"groupName": "origin-ca-issuer"
		},
		{
			"description": "ncps is pinned to a v0.10.0 release candidate, see docs/ncps.md",
			"matchPackageNames": [
				"kalbasit/ncps"
			],
			"ignoreUnstable": false
		},
		{
			"matchPackageNames": [
				"adyanth/cloudflare-operator"
			],
			"groupName": "cloudflare-operator"
		},
		{
			"matchPackageNames": [
				"xpkg.crossplane.io/crossplane/crossplane",
				"crossplane"
			],
			"groupName": "crossplane"
		},
		{
			"matchPackageNames": [
				"xpkg.crossplane.io/crossplane-contrib/provider-family-aws",
				"xpkg.crossplane.io/crossplane-contrib/provider-aws-s3",
				"xpkg.crossplane.io/crossplane-contrib/provider-aws-ses",
				"xpkg.crossplane.io/crossplane-contrib/provider-aws-iam"
			],
			"groupName": "provider-family-aws"
		},
		{
			"matchPackageNames": [
				"ghcr.io/renovatebot/renovate"
			],
			"matchUpdateTypes": [
				"patch"
			],
			"enabled": false
		},
		{
			"matchPackageNames": [
				"ghcr.io/renovatebot/renovate",
				"renovate"
			],
			"groupName": "renovate",
			"automerge": true
		},
		{
			"matchPackageNames": [
				"gitea",
				"docker.gitea.com/gitea"
			],
			"groupName": "gitea"
		},
		{
			"matchPackageNames": [
				"pihole",
				"pihole/pihole"
			],
			"groupName": "pihole"
		},
		{
			"matchPackageNames": [
				"cloudflare-tunnel-ingress-controller",
				"ghcr.io/strrl/cloudflare-tunnel-ingress-controller"
			],
			"groupName": "cloudflare-tunnel-ingress-controller"
		},
		{
			"matchPackageNames": [
				"cloudnative-pg",
				"ghcr.io/cloudnative-pg/cloudnative-pg"
			],
			"groupName": "cnpg"
		},
		{
			"matchPackageNames": [
				"metrics-server",
				"registry.k8s.io/metrics-server/metrics-server"
			],
			"groupName": "metrics-server"
		},
		{
			"matchPackageNames": [
				"nats"
			],
			"groupName": "nats"
		},
		{
			"matchPackageNames": [
				"velero",
				"velero/velero"
			],
			"groupName": "velero"
		},
		{
			"matchPackageNames": [
				"ghcr.io/actions/actions-runner-controller-charts/gha-runner-scale-set-controller",
				"ghcr.io/actions/actions-runner-controller-charts/gha-runner-scale-set",
				"ghcr.io/actions/gha-runner-scale-set-controller"
			],
			"groupName": "arc"
		},
		{
			"matchPackageNames": [
				"ghcr.io/actions/actions-runner"
			],
			"groupName": "actions-runner"
		},
		{
			"matchFileNames": [
				"containers/runner/default.nix"
			],
			"matchPackageNames": [
				"ghcr.io/actions/actions-runner"
			],
			"description": "Renovate updates only `finalImageTag` in containers/runner/default.nix. Refresh every `baseImages` entry by hand on this PR, both x86_64-linux and aarch64-linux: each `imageDigest`, from `docker buildx imagetools inspect ghcr.io/actions/actions-runner:<new tag> --raw` (take the per-architecture manifest digest matching that system, not the index digest), and each `hash`, from the `got:` line of the mismatch error that system's build prints once its digest is in place. A wrong value surfaces only on the architecture it belongs to, so both hashes come from the Containers workflow, which builds each system on a native runner."
		},
		{
			"matchPackageNames": [
				"operator-framework/operator-controller",
				"quay.io/operator-framework/operator-controller",
				"quay.io/operator-framework/catalogd"
			],
			"groupName": "olmv1"
		},
		{
			"matchPackageNames": [
				"quay.io/operator-framework/catalogd"
			],
			"description": "v1.18.0 is ~2 years old and likely a maintainer typo",
			"allowedVersions": "!/1.18.0/"
		},
		{
			"matchPackageNames": [
				"self-host",
				"/^ghcr\\.io\\/bitwarden\\//"
			],
			"groupName": "bitwarden"
		},
		{
			"matchPackageNames": [
				"rook-ceph",
				"rook-ceph-cluster",
				"quay.io/ceph/ceph"
			],
			"groupName": "rook-ceph"
		},
		{
			"matchPackageNames": [
				"plex-media-server",
				"plexinc/pms-docker"
			],
			"groupName": "plex"
		},
		{
			"matchPackageNames": [
				"ghcr.io/meeb/tubesync"
			],
			"groupName": "tubesync"
		},
		{
			"matchPackageNames": [
				"ghcr.io/9001/copyparty-ac"
			],
			"groupName": "copyparty"
		},
		{
			"matchPackageNames": [
				"oci://registry-1.docker.io/bitnamicharts/keycloak",
				"bitnami/keycloak"
			],
			"groupName": "keycloak"
		},
		{
			"matchPackageNames": [
				"dex",
				"ghcr.io/dexidp/dex"
			],
			"groupName": "dex"
		}
	]
}
